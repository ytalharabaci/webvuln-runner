#!/usr/bin/env bash
# WebVuln-Runner - start deliberately vulnerable labs in Docker from a TUI or the command line.
set -uo pipefail

WVR_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
WVR_HOME="${WVR_HOME:-$WVR_ROOT}"

# shellcheck source=lib/common.sh
source "$WVR_ROOT/lib/common.sh"
# shellcheck source=lib/catalog.sh
source "$WVR_ROOT/lib/catalog.sh"
# shellcheck source=lib/docker.sh
source "$WVR_ROOT/lib/docker.sh"
# shellcheck source=lib/ui.sh
source "$WVR_ROOT/lib/ui.sh"

wvr_usage() {
  cat <<EOF
WebVuln-Runner $WVR_VERSION - deliberately vulnerable labs in Docker

Usage:
  webvuln-runner                       interactive menu
  webvuln-runner catalog [--topic T] [--category C] [--level L]
                                       list labs that can be started
  webvuln-runner topics                vulnerability topics and how many labs cover each
  webvuln-runner list                  list your labs and their state
  webvuln-runner up <lab> [options]    create and start a lab
      --name NAME     instance name (default: wvr-<lab>)
      --port PORT     host port for the lab's main port (default: first free one)
      --bind ADDR     address to publish on (default: 127.0.0.1)
      --no-wait       do not wait for the app to answer
  webvuln-runner start|stop|status <name>
  webvuln-runner stop --all            stop every lab
  webvuln-runner stats [name]          CPU and memory of running labs
  webvuln-runner logs <name> [--tail N]
  webvuln-runner rm <name> [--volumes]
  webvuln-runner rm --all --yes [--volumes]   remove every lab
  webvuln-runner validate [catalog.json]
  webvuln-runner uninstall
  webvuln-runner version

Labs are published on 127.0.0.1 unless you pass --bind or set WVR_BIND.
Only containers created by WebVuln-Runner are listed or touched.

Exit codes: 0 ok, 1 error, 2 usage error, 3 lab started but not ready in time.
EOF
}

wvr_usage_error() {
  wvr_err "$1"
  wvr_err "run 'webvuln-runner help' for usage"
  return 2
}

wvr_cmd_catalog() {
  local topic="" cat="" level="" id type lvl topics rows
  while (( $# )); do
    case "$1" in
      --topic)    [[ $# -ge 2 ]] || { wvr_usage_error "--topic needs a value"; return; }; topic="$2"; shift 2 ;;
      --category) [[ $# -ge 2 ]] || { wvr_usage_error "--category needs a value"; return; }; cat="$2"; shift 2 ;;
      --level)    [[ $# -ge 2 ]] || { wvr_usage_error "--level needs a value"; return; }; level="$2"; shift 2 ;;
      *)          wvr_usage_error "unknown option: $1"; return ;;
    esac
  done
  if [[ -n "$topic" ]] && ! jq -e --arg t "$topic" 'index($t) != null' <<<"$WVR_TOPICS" >/dev/null; then
    wvr_usage_error "unknown topic '$topic' (see 'webvuln-runner topics')"
    return
  fi
  rows="$(wvr_catalog_list_filtered "$topic" "$cat" "$level")"
  if [[ -z "$rows" ]]; then
    wvr_info "No lab matches."
    return 0
  fi
  printf '%-18s %-10s %-13s %-8s %s\n' "LAB" "CATEGORY" "LEVEL" "TYPE" "TOPICS"
  while IFS=$'\t' read -r id _ cat type _ lvl topics; do
    printf '%-18s %-10s %-13s %-8s %s\n' "$id" "$cat" "$lvl" "$type" "${topics//,/, }"
  done <<<"$rows"
}

wvr_cmd_topics() {
  local topic n
  printf '%-16s %s\n' "TOPIC" "LABS"
  while IFS=$'\t' read -r topic n; do
    printf '%-16s %s\n' "$topic" "$n"
  done < <(wvr_catalog_topics)
  wvr_info ""
  wvr_info "Show the labs for one topic with: webvuln-runner catalog --topic <topic>"
}

wvr_cmd_list() {
  local rows name lab state url
  rows="$(wvr_instances)"
  if [[ -z "$rows" ]]; then
    wvr_info "No labs yet. Start one with: webvuln-runner up <lab>   (see 'webvuln-runner catalog')"
    return 0
  fi
  printf '%-24s %-18s %-12s %s\n' "NAME" "LAB" "STATE" "URL"
  while IFS=$'\t' read -r name lab state url; do
    printf '%-24s %-18s %-12s %s\n' "$name" "$lab" "$state" "$url"
  done <<<"$rows"
}

wvr_cmd_up() {
  local id="" name="" port="" bind="$WVR_BIND" wait=1
  while (( $# )); do
    case "$1" in
      --name)    [[ $# -ge 2 ]] || { wvr_usage_error "--name needs a value"; return; }; name="$2"; shift 2 ;;
      --port)    [[ $# -ge 2 ]] || { wvr_usage_error "--port needs a value"; return; }; port="$2"; shift 2 ;;
      --bind)    [[ $# -ge 2 ]] || { wvr_usage_error "--bind needs a value"; return; }; bind="$2"; shift 2 ;;
      --no-wait) wait=0; shift ;;
      -*)        wvr_usage_error "unknown option: $1"; return ;;
      *)         [[ -z "$id" ]] || { wvr_usage_error "unexpected argument: $1"; return; }; id="$1"; shift ;;
    esac
  done
  [[ -n "$id" ]] || { wvr_usage_error "missing lab id"; return; }
  wvr_catalog_has "$id" || { wvr_err "unknown lab: $id (see 'webvuln-runner catalog')"; return 1; }
  [[ -n "$name" ]] || name="$(wvr_default_name "$id")"

  wvr_up "$id" "$name" "$bind" "$port" || return 1
  (( wait )) || return 0
  wvr_info "Waiting for '$name' to answer (up to $(wvr_health_timeout "$name")s)..."
  if wvr_health_wait "$name"; then
    wvr_info "'$name' is ready: $(wvr_instance_label "$name" "$WVR_LABEL_URL")"
  else
    wvr_warn "'$name' is running but not answering yet; check 'webvuln-runner logs $name'"
    return 3
  fi
}

wvr_cmd_logs() {
  local name="" lines=200
  while (( $# )); do
    case "$1" in
      --tail) [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || { wvr_usage_error "--tail needs a number"; return; }; lines="$2"; shift 2 ;;
      -*)     wvr_usage_error "unknown option: $1"; return ;;
      *)      name="$1"; shift ;;
    esac
  done
  [[ -n "$name" ]] || { wvr_usage_error "missing lab name"; return; }
  wvr_logs "$name" "$lines"
}

wvr_cmd_rm() {
  local name="" vol="" all=0 yes=0
  while (( $# )); do
    case "$1" in
      --volumes) vol="--volumes"; shift ;;
      --all)     all=1; shift ;;
      --yes)     yes=1; shift ;;
      -*)        wvr_usage_error "unknown option: $1"; return ;;
      *)         name="$1"; shift ;;
    esac
  done
  if (( all )); then
    [[ -z "$name" ]] || { wvr_usage_error "use either a lab name or --all"; return; }
    (( yes )) || { wvr_usage_error "rm --all removes every lab created by WebVuln-Runner; add --yes to confirm"; return; }
    wvr_rm_all "$vol"
    return
  fi
  [[ -n "$name" ]] || { wvr_usage_error "missing lab name"; return; }
  wvr_rm "$name" "$vol" && wvr_info "removed $name"
}

wvr_cmd_uninstall() {
  if [[ -x "$WVR_ROOT/uninstall.sh" ]]; then
    exec "$WVR_ROOT/uninstall.sh"
  fi
  wvr_err "this copy was not installed by an installer script; nothing to uninstall"
  return 1
}

main() {
  local cmd="${1:-}"
  (( $# )) && shift

  case "$cmd" in
    help|-h|--help)       wvr_usage; return 0 ;;
    version|-V|--version) wvr_info "webvuln-runner $WVR_VERSION"; return 0 ;;
    uninstall)            wvr_cmd_uninstall; return ;;
  esac

  wvr_check_deps jq || return 1
  wvr_catalog_init || return 1

  case "$cmd" in
    validate)
      local file="${1:-$WVR_CATALOG}"
      wvr_catalog_validate "$file" || return 1
      wvr_info "catalog OK: $(jq '.labs | length' "$file") labs"
      return 0 ;;
    catalog)
      wvr_cmd_catalog "$@"
      return ;;
    topics)
      wvr_cmd_topics
      return ;;
  esac

  wvr_check_deps docker curl || return 1
  wvr_check_docker || return 1
  if ! wvr_catalog_validate; then
    wvr_err "the catalog ($WVR_CATALOG) is invalid; fix the problems above"
    return 1
  fi

  case "$cmd" in
    "")
      wvr_check_deps whiptail || return 1
      wvr_tui_main ;;
    list)   wvr_cmd_list ;;
    up)     wvr_cmd_up "$@" ;;
    stats)  wvr_stats "${1:-}" ;;
    start|stop|status)
      if [[ "$cmd" == "stop" && "${1:-}" == "--all" && $# -eq 1 ]]; then
        wvr_stop_all
        return
      fi
      [[ $# -eq 1 ]] || { wvr_usage_error "usage: webvuln-runner $cmd <name>"; return; }
      "wvr_$cmd" "$1" || return 1
      case "$cmd" in
        start) wvr_info "started $1" ;;
        stop)  wvr_info "stopped $1" ;;
      esac ;;
    logs)   wvr_cmd_logs "$@" ;;
    rm)     wvr_cmd_rm "$@" ;;
    *)      wvr_usage_error "unknown command: $cmd" ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
